# Copy to .env and fill in. Never commit .env.

# You.com: web grounding for the Field Researcher (https://you.com/home)
YDC_API_KEY=
# Parasail: every model call (https://www.saas.parasail.io/keys)
PARASAIL_API_KEY=
PARASAIL_COMPOSE_MODEL=parasail-gpt-oss-120b-fast
PARASAIL_EXTRACT_MODEL=parasail-gpt-oss-120b-fast
PARASAIL_FALLBACK_MODEL=parasail-llama-33-70b-fp8
PARASAIL_EMBED_MODEL=parasail-bge-m3

# Dispatch: dry = show the alert in the UI only; live = post it to #loft-incident
DISPATCH_MODE=dry
# The venue webhook URL from the event page (section 3.4). Keep it here, never in code.
DISCORD_WEBHOOK_URL=
# Your self-chosen handle: lowercase, digits and dashes. Every post starts with it.
TEAM_HANDLE=

# Keep CrewAI from phoning home during the demo
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
PORT=8666
